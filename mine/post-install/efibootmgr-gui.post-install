install -Dpm 0644 $CWD/post-install/efibootmgr-gui/org.freedesktop.policykit.pkexec.efiboots.policy -t  $PKG/usr/share/polkit-1/actions
cp -av $PKG/usr/share/applications/ovh.elinvention.Efiboots.desktop  $PKG/usr/share/applications/ovh.elinvention.Efiboots2.desktop

sed -i "s|Exec=.*|Exec=pkexec efiboots|" $PKG/usr/share/applications/ovh.elinvention.Efiboots.desktop
sed -i "s|Exec=.*|Exec=pkexec /usr/libexec/efiboots-root|" $PKG/usr/share/applications/ovh.elinvention.Efiboots2.desktop

sed -i "s|Categories=.*|Categories=Application;System;Settings;X-Zenpanel;X-XFCE-SettingsDialog;X-XFCE-SystemSettings;|" ${PKG}/usr/share/applications/ovh.elinvention.Efiboots.desktop
sed -i 's|^Comment=Manage EFI boot loader entries with this simple GUI$|& for Wayland|' /usr/share/applications/ovh.elinvention.Efiboots2.desktop
sed -i "s|Categories=.*|Categories=Application;System;Settings;X-Zenpanel;X-XFCE-SettingsDialog;X-XFCE-SystemSettings;|" ${PKG}/usr/share/applications/ovh.elinvention.Efiboots2.desktop


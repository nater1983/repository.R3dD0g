mkdir build
cd build
  CFLAGS="$SLKCFLAGS" \
  CXXFLAGS="$SLKCFLAGS" \
  meson setup ..\
    "${MINE_BUILD_ARGS[@]}" \
    $MINE_OPT_ARGS \
    -Dprivileged-group=wheel \
    -Dhwclock_conf=/etc/hardwareclock \
    -Dadjtime_conf=/etc/adjtime \
    -Dntpd_conf=/etc/ntp.conf \
    -Dntpd_rc=/etc/rc.d/rc.ntpd
  "${NINJA:=ninja}"
  DESTDIR=$PKG $NINJA install
cd ..

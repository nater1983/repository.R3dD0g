mkdir build
cd build
  CFLAGS="$SLKCFLAGS" \
  CXXFLAGS="$SLKCFLAGS" \
  meson setup ..\
    "${MINE_BUILD_ARGS[@]}" \
    $MINE_OPT_ARGS \
    -Dprivileged-group=wheel \
    -Dmachine_conf=/etc/machine-info \
    -Dhostname_conf=/etc/HOSTNAME \
    -Dos_conf=/etc/os-release
  "${NINJA:=ninja}"
  DESTDIR=$PKG $NINJA install
cd ..
